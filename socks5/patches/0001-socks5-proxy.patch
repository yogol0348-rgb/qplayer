+import io.github.timer_err.qml4j.engine.QmlEngine;
+import io.github.timer_err.qml4j.engine.binding.DirtyQueue;
+import io.github.timer_err.qml4j.engine.binding.Property;
+import io.github.timer_err.qml4j.render.QmlView;
+import io.github.timer_err.qml4j.render.items.core.Item;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Proxy;
+import java.nio.file.Path;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * The About page's SOCKS5 row is the only built-in TEXT setting: typing an
+ * endpoint and pressing Enter must persist it and switch GitHub traffic onto the
+ * proxy; an invalid or empty value must leave the proxy off.
+ */
+public class SocksProxySettingRowTest {
+
+    @Rule public final TemporaryFolder temporary = new TemporaryFolder();
+
+    @Test
+    public void typingAnEndpointOnTheAboutPageEnablesTheProxy() throws Exception {
+        String oldBase = AppDirs.base();
+        String oldCache = AppDirs.cacheBase();
+        QmlView view = null;
+        PlayerController player = null;
+        try {
+            Path base = temporary.newFolder().toPath();
+            AppDirs.setBase(base.toString());
+            AppDirs.setCacheBase(base.resolve("cache").toString());
+            AudioBackend backend = (AudioBackend) Proxy.newProxyInstance(
+                    AudioBackend.class.getClassLoader(), new Class<?>[]{AudioBackend.class},
+                    (proxy, method, args) -> {
+                        if (method.getReturnType() == boolean.class) return false;
+                        if (method.getReturnType() == long.class) return 0L;
+                        return null;
+                    });
+            player = new PlayerController(backend, track -> { });
+            // Wired like desktop Main: attach before load so the replay reaches the controller.
+            SettingsCore settings = new SettingsCore();
+            settings.attach(player);
+            settings.load(new JsonSettingsStore(), SettingsCatalog.DESKTOP);
+            assertTrue(settings.has("socksProxy"));
+            assertFalse("blank default leaves the proxy off", NetworkProxy.enabled());
+
+            view = QmlView.withStockTypes(new QmlEngine()).resources(new ClasspathResourceLoader())
+                    .context("player", player).context("settings", settings)
+                    .context("i18n", I18n.instance());
+            view.load("import QtQuick\nimport \"settings\"\n"
+                    + "Item { width: 900; height: 2400\n"
+                    + "  SettingsPage { anchors.fill: parent; currentCategory: \"about\" }\n"
+                    + "}");
+
+            DirtyQueue queue = view.dirtyQueue();
+            queue.install();
+            try {
+                settle(view, queue);
+                // Hidden dialogs (colour picker, ...) carry TextFields too: pick
+                // the one labelled with the SOCKS5 hint.
+                Item input = socksInput(view.root(), I18n.tr("settings.socksProxy.hint"));
+                assertNotNull("the About page shows the SOCKS5 text field", input);
+                assertTrue(Boolean.TRUE.equals(input.visible.peek()));
+
+                type(view, queue, input, "qp:secret@127.0.0.1:7890");
+                assertEquals("qp:secret@127.0.0.1:7890", settings.str("socksProxy"));
+                assertTrue(NetworkProxy.enabled());
+                assertEquals("127.0.0.1:7890", NetworkProxy.describe());
+
+                // A restart replays the persisted value from disk.
+                NetworkProxy.configure("");
+                SettingsCore restarted = new SettingsCore();
+                restarted.attach(player);
+                restarted.load(new JsonSettingsStore(), SettingsCatalog.DESKTOP);
+                assertEquals("qp:secret@127.0.0.1:7890", restarted.str("socksProxy"));
+                assertTrue("the saved proxy is applied again at load", NetworkProxy.enabled());
+
+                type(view, queue, input, "not a proxy");
+                assertFalse("an invalid value turns the proxy off", NetworkProxy.enabled());
+
+                type(view, queue, input, "");
+                assertEquals("", settings.str("socksProxy"));
+                assertFalse(NetworkProxy.enabled());
+            } finally {
+                queue.uninstall();
+            }
+        } finally {
+            NetworkProxy.configure("");
+            if (view != null) view.dispose();
+            if (player != null) player.shutdownAsync().join();
+            AppDirs.setBase(oldBase);
+            AppDirs.setCacheBase(oldCache);
+        }
+    }
+
+    /** Focus by tapping, replace the text the way InputBridge feeds it, then Enter. */
+    private static void type(QmlView view, DirtyQueue queue, Item input, String text) throws Exception {
+        float cx = centreX(input);
+        float cy = centreY(input);
+        view.dispatchPointerDown(cx, cy);
+        view.dispatchPointerUp(cx, cy);
+        queue.flush();
+        property(input, "text").set("");
+        queue.flush();
+        if (!text.isEmpty()) view.dispatchKey(0, text, true);
+        queue.flush();
+        assertEquals(text, property(input, "text").peek());
+        view.dispatchKey(QmlView.KEY_ENTER, null, true);
+        view.dispatchKey(QmlView.KEY_ENTER, null, false);
+        settle(view, queue);
+    }
+
+    /** The TextInput whose sibling label shows {@code hint}. */
+    private static Item socksInput(Item item, String hint) throws Exception {
+        Item input = null;
+        boolean labelled = false;
+        for (Item child : item.children) {
+            String name = child.objectName.peek();
+            if ("miuixTextFieldInput".equals(name)) input = child;
+            if ("miuixTextFieldLabel".equals(name)
+                    && hint.equals(String.valueOf(property(child, "text").peek()))) labelled = true;
+        }
+        if (input != null && labelled) return input;
+        for (Item child : item.children) {
+            Item found = socksInput(child, hint);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <T> Property<T> property(Item item, String name) throws Exception {
+        Field field = item.getClass().getField(name);
+        return (Property<T>) field.get(item);
+    }
+
+    private static float centreX(Item item) {
+        float x = item.width.peekFloat() / 2f;
+        for (Item i = item; i != null; i = i.parent.peek()) x += i.x.peekFloat();
+        return x;
+    }
+
+    private static float centreY(Item item) {
+        float y = item.height.peekFloat() / 2f;
+        for (Item i = item; i != null; i = i.parent.peek()) y += i.y.peekFloat();
+        return y;
+    }
+
+    private static void settle(QmlView view, DirtyQueue queue) {
+        for (int i = 0; i < 4; i++) {
+            queue.flush();
+            view.renderer().layoutOnly(view.root());
+        }
+        queue.flush();
+    }
+}
