diff --git a/player-core/src/test/java/dev/t1m3/qplayer/util/NetworkProxyTest.java b/player-core/src/test/java/dev/t1m3/qplayer/util/NetworkProxyTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..c395c6c198c9c4da9313b99773e5312b7de21b08
--- /dev/null
+++ b/player-core/src/test/java/dev/t1m3/qplayer/util/NetworkProxyTest.java
@@ -0,0 +1,255 @@
+package dev.t1m3.qplayer.util;
+
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+
+import org.junit.After;
+import org.junit.Test;
+
+import java.io.DataInputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.net.InetSocketAddress;
+import java.net.Proxy;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+public class NetworkProxyTest {
+    @After public void reset() {
+        NetworkProxy.configure("");
+    }
+
+    @Test public void parsesCommonForms() {
+        assertNull(NetworkProxy.parse(null));
+        assertNull(NetworkProxy.parse("   "));
+
+        NetworkProxy.Endpoint plain = NetworkProxy.parse(" 127.0.0.1:7890 ");
+        assertEquals("127.0.0.1", plain.host);
+        assertEquals(7890, plain.port);
+        assertNull(plain.user);
+
+        NetworkProxy.Endpoint scheme = NetworkProxy.parse("socks5h://proxy.lan:1080/");
+        assertEquals("proxy.lan", scheme.host);
+        assertEquals(1080, scheme.port);
+
+        NetworkProxy.Endpoint auth = NetworkProxy.parse("socks5://me:p@ss:w@rd@10.0.0.2:1080");
+        assertEquals("me", auth.user);
+        assertEquals("p@ss:w@rd", auth.password);
+        assertEquals("10.0.0.2", auth.host);
+
+        NetworkProxy.Endpoint v6 = NetworkProxy.parse("[::1]:1080");
+        assertEquals("::1", v6.host);
+        assertEquals(1080, v6.port);
+        assertEquals(Proxy.Type.SOCKS, v6.proxy.type());
+        assertTrue(((InetSocketAddress) v6.proxy.address()).isUnresolved());
+    }
+
+    @Test public void rejectsInvalidForms() {
+        String[] invalid = {
+                "127.0.0.1", "127.0.0.1:", ":1080", "host:0", "host:65536", "host:12ab",
+                "http://127.0.0.1:7890", "::1:1080", "[::1]1080", "@host:1080",
+                "bad host:1080", "host/path:1080"
+        };
+        for (String spec : invalid) {
+            try {
+                NetworkProxy.parse(spec);
+                fail("accepted " + spec);
+            } catch (IllegalArgumentException expected) {
+                // expected
+            }
+        }
+        assertTrue(NetworkProxy.configure("127.0.0.1:7890"));
+        assertFalse(NetworkProxy.configure("nonsense"));
+        assertFalse("an invalid setting disables the proxy", NetworkProxy.enabled());
+    }
+
+    @Test public void selectorProxiesGitHubHostsOnly() throws Exception {
+        assertTrue(NetworkProxy.configure("127.0.0.1:7890"));
+        assertEquals("127.0.0.1:7890", NetworkProxy.describe());
+        for (String url : new String[]{
+                "https://api.github.com/repos/a/b/releases/latest",
+                "https://github.com/a/b/releases/download/v1/x.apk",
+                "https://release-assets.githubusercontent.com/x"}) {
+            List<Proxy> selected = NetworkProxy.selector().select(new URI(url));
+            assertEquals(url, Proxy.Type.SOCKS, selected.get(0).type());
+        }
+        for (String url : new String[]{
+                "https://music.163.com/api", "https://gh-proxy.com/https://github.com/a",
+                "https://notgithub.com/x"}) {
+            List<Proxy> selected = NetworkProxy.selector().select(new URI(url));
+            assertNotEquals(url, Proxy.Type.SOCKS, selected.get(0).type());
+        }
+        NetworkProxy.configure("");
+        assertNotEquals(Proxy.Type.SOCKS, NetworkProxy.selector()
+                .select(new URI("https://github.com/")).get(0).type());
+    }
+
+    /** OkHttp sends the GitHub host name (not a locally resolved address) and the credentials. */
+    @Test public void okHttpTunnelsGitHubThroughSocks5WithRemoteDnsAndAuth() throws Exception {
+        try (FakeSocks5 socks = new FakeSocks5("user", "secret")) {
+            assertTrue(NetworkProxy.configure("user:secret@127.0.0.1:" + socks.port()));
+            OkHttpClient client = new OkHttpClient.Builder()
+                    .proxySelector(NetworkProxy.selector())
+                    .connectTimeout(5, TimeUnit.SECONDS)
+                    .readTimeout(5, TimeUnit.SECONDS)
+                    .build();
+            // Plain HTTP so the fake proxy can answer without TLS; routing is host-based.
+            try (Response response = client.newCall(new Request.Builder()
+                    .url("http://api.github.com/repos/a/b").build()).execute()) {
+                assertEquals(200, response.code());
+                assertEquals("via-socks", response.body().string());
+            }
+            assertEquals("api.github.com:80", socks.target);
+            assertEquals(3, socks.addressType); // DOMAINNAME: DNS resolved at the proxy
+            assertEquals("user:secret", socks.credentials);
+            client.connectionPool().evictAll();
+        }
+    }
+
+    /** The hosts' update download path: same proxy, remote DNS, progress, file written. */
+    @Test public void updateDownloaderTunnelsGitHubThroughSocks5() throws Exception {
+        java.io.File out = java.io.File.createTempFile("qplayer-update", ".apk");
+        out.deleteOnExit();
+        try (FakeSocks5 socks = new FakeSocks5(null, null)) {
+            assertTrue(NetworkProxy.configure("127.0.0.1:" + socks.port()));
+            List<Integer> progress = new java.util.ArrayList<>();
+            OkHttpClient client = new OkHttpClient.Builder()
+                    .proxySelector(NetworkProxy.selector())
+                    .connectTimeout(5, TimeUnit.SECONDS)
+                    .readTimeout(5, TimeUnit.SECONDS)
+                    .build();
+            assertTrue(UpdateDownloader.downloadOne(client,
+                    "http://github.com/a/b/releases/download/v1/x.apk", out, progress::add));
+            assertEquals("github.com:80", socks.target);
+            assertEquals(3, socks.addressType);
+            assertNull(socks.credentials);
+            assertEquals("via-socks", new String(java.nio.file.Files.readAllBytes(out.toPath()),
+                    StandardCharsets.UTF_8));
+            assertEquals(Integer.valueOf(100), progress.get(progress.size() - 1));
+        } finally {
+            out.delete();
+        }
+    }
+
+    @Test public void updateDownloaderReportsAnUnreachableProxyAsFailure() throws Exception {
+        java.io.File out = java.io.File.createTempFile("qplayer-update", ".apk");
+        out.deleteOnExit();
+        int closedPort;
+        try (ServerSocket probe = new ServerSocket(0)) {
+            closedPort = probe.getLocalPort();
+        }
+        assertTrue(NetworkProxy.configure("127.0.0.1:" + closedPort));
+        try {
+            assertFalse(UpdateDownloader.downloadOne(
+                    "http://github.com/a/b/releases/download/v1/x.apk", out, pct -> { }));
+        } finally {
+            out.delete();
+        }
+    }
+
+    /**
+     * One-connection RFC 1928/1929 server. After CONNECT it answers the tunnelled
+     * HTTP request itself instead of dialling out, so the test needs no network.
+     */
+    private static final class FakeSocks5 implements AutoCloseable {
+        private final ServerSocket server = new ServerSocket(0, 1,
+                java.net.InetAddress.getByName("127.0.0.1"));
+        private final Thread thread;
+        private final String user;
+        private final String password;
+        volatile String target;
+        volatile int addressType;
+        volatile String credentials;
+
+        FakeSocks5(String user, String password) throws IOException {
+            this.user = user;
+            this.password = password;
+            thread = new Thread(this::serve, "fake-socks5");
+            thread.setDaemon(true);
+            thread.start();
+        }
+
+        int port() {
+            return server.getLocalPort();
+        }
+
+        private void serve() {
+            try (Socket socket = server.accept()) {
+                socket.setSoTimeout(5000);
+                DataInputStream in = new DataInputStream(socket.getInputStream());
+                OutputStream out = socket.getOutputStream();
+                if (in.readUnsignedByte() != 5) return;
+                int methods = in.readUnsignedByte();
+                boolean offersAuth = false;
+                for (int i = 0; i < methods; i++) offersAuth |= in.readUnsignedByte() == 2;
+                if (user != null) {
+                    if (!offersAuth) return;
+                    out.write(new byte[]{5, 2});
+                    out.flush();
+                    in.readUnsignedByte(); // sub-negotiation version 1
+                    byte[] name = new byte[in.readUnsignedByte()];
+                    in.readFully(name);
+                    byte[] pass = new byte[in.readUnsignedByte()];
+                    in.readFully(pass);
+                    credentials = new String(name, StandardCharsets.UTF_8) + ":"
+                            + new String(pass, StandardCharsets.UTF_8);
+                    boolean ok = credentials.equals(user + ":" + password);
+                    out.write(new byte[]{1, (byte) (ok ? 0 : 1)});
+                    out.flush();
+                    if (!ok) return;
+                } else {
+                    out.write(new byte[]{5, 0});
+                    out.flush();
+                }
+                in.readUnsignedByte(); // version
+                if (in.readUnsignedByte() != 1) return; // CONNECT only
+                in.readUnsignedByte(); // reserved
+                addressType = in.readUnsignedByte();
+                String host;
+                if (addressType == 3) {
+                    byte[] name = new byte[in.readUnsignedByte()];
+                    in.readFully(name);
+                    host = new String(name, StandardCharsets.US_ASCII);
+                } else {
+                    byte[] raw = new byte[addressType == 4 ? 16 : 4];
+                    in.readFully(raw);
+                    host = java.net.InetAddress.getByAddress(raw).getHostAddress();
+                }
+                int port = in.readUnsignedShort();
+                target = host + ":" + port;
+                out.write(new byte[]{5, 0, 0, 1, 127, 0, 0, 1, 0, 0});
+                out.flush();
+
+                // Tunnelled HTTP request: drain the head, then answer.
+                int matched = 0;
+                while (matched < 4) {
+                    int b = in.read();
+                    if (b < 0) return;
+                    matched = (b == "\r\n\r\n".charAt(matched)) ? matched + 1 : (b == '\r' ? 1 : 0);
+                }
+                out.write(("HTTP/1.1 200 OK\r\nContent-Length: 9\r\nConnection: close\r\n\r\nvia-socks")
+                        .getBytes(StandardCharsets.US_ASCII));
+                out.flush();
+            } catch (IOException ignored) {
+                // The assertions report what the client did or did not send.
+            }
+        }
+
+        @Override public void close() throws Exception {
+            server.close();
+            thread.join(5000);
+        }
+    }
+}
