+/**
+ * Optional user SOCKS5 proxy for GitHub traffic: update checks and downloads, the
+ * plugin catalog and plugin packages. Every other host (music APIs, streams,
+ * covers, third-party mirrors) keeps the platform's default proxy selection, so a
+ * foreign exit never sits in front of mainland music services.
+ *
+ * <p>Callers are OkHttp clients using {@link #selector()}. For a SOCKS proxy
+ * OkHttp hands the proxy an unresolved host name, so DNS happens at the proxy
+ * (a JDK {@code URLConnection} would resolve locally first).
+ */
+public final class NetworkProxy {
+    /** A parsed, immutable proxy setting. */
+    static final class Endpoint {
+        final String host;
+        final int port;
+        final String user;
+        final String password;
+        final Proxy proxy;
+
+        Endpoint(String host, int port, String user, String password) {
+            this.host = host;
+            this.port = port;
+            this.user = user;
+            this.password = password;
+            // Unresolved: never block the settings thread on DNS for the proxy host.
+            this.proxy = new Proxy(Proxy.Type.SOCKS, InetSocketAddress.createUnresolved(host, port));
+        }
+    }
+
+    private static volatile Endpoint endpoint;
+    private static boolean authenticatorInstalled;
+
+    private static final ProxySelector SELECTOR = new ProxySelector() {
+        @Override
+        public List<Proxy> select(URI uri) {
+            Proxy proxy = uri == null ? null : proxyForHost(uri.getHost());
+            if (proxy != null) return Collections.singletonList(proxy);
+            ProxySelector platform = ProxySelector.getDefault();
+            if (platform == null || platform == this) return Collections.singletonList(Proxy.NO_PROXY);
+            return platform.select(uri);
+        }
+
+        @Override
+        public void connectFailed(URI uri, SocketAddress address, IOException error) {
+            if (uri != null && proxyForHost(uri.getHost()) != null) return;
+            ProxySelector platform = ProxySelector.getDefault();
+            if (platform != null && platform != this) platform.connectFailed(uri, address, error);
+        }
+    };
+
+    private NetworkProxy() {}
+
+    /**
+     * Apply the user's setting. Accepts {@code host:port}, {@code [ipv6]:port},
+     * an optional {@code user:password@} prefix and an optional {@code socks5://}
+     * / {@code socks5h://} / {@code socks://} scheme. Blank disables the proxy.
+     *
+     * @return false when the text is not a valid proxy; the proxy is then disabled
+     */
+    public static boolean configure(String spec) {
+        Endpoint parsed;
+        try {
+            parsed = parse(spec);
+        } catch (IllegalArgumentException invalid) {
+            endpoint = null;
+            return false;
+        }
+        if (parsed != null && parsed.user != null) installAuthenticator();
+        endpoint = parsed;
+        return true;
+    }
+
+    public static boolean enabled() {
+        return endpoint != null;
+    }
+
+    /** {@code host:port} of the active proxy without credentials, or empty. */
+    public static String describe() {
+        Endpoint e = endpoint;
+        if (e == null) return "";
+        return (e.host.indexOf(':') >= 0 ? "[" + e.host + "]" : e.host) + ":" + e.port;
+    }
+
+    /** Selector for OkHttp clients: the SOCKS proxy for GitHub hosts, platform default otherwise. */
+    public static ProxySelector selector() {
+        return SELECTOR;
+    }
+
+    static Proxy proxyForHost(String host) {
+        Endpoint e = endpoint;
+        if (e == null || !GitHubDownloadUrls.isGitHubHost(host)) return null;
+        return e.proxy;
+    }
+
+    /** Null for blank input; IllegalArgumentException for anything that is not a SOCKS endpoint. */
+    static Endpoint parse(String spec) {
+        if (spec == null) return null;
+        String s = spec.trim();
+        if (s.isEmpty()) return null;
+
+        int scheme = s.indexOf("://");
+        if (scheme >= 0) {
+            String name = s.substring(0, scheme).toLowerCase(Locale.ROOT);
+            if (!name.equals("socks5") && !name.equals("socks5h") && !name.equals("socks")) {
+                throw new IllegalArgumentException("unsupported proxy scheme: " + name);
+            }
+            s = s.substring(scheme + 3);
+        }
+        if (s.endsWith("/")) s = s.substring(0, s.length() - 1);
+
+        String user = null;
+        String password = null;
+        int at = s.lastIndexOf('@');
+        if (at >= 0) {
+            String credentials = s.substring(0, at);
+            s = s.substring(at + 1);
+            int colon = credentials.indexOf(':');
+            user = colon >= 0 ? credentials.substring(0, colon) : credentials;
+            password = colon >= 0 ? credentials.substring(colon + 1) : "";
+            if (user.isEmpty()) throw new IllegalArgumentException("empty proxy user name");
+            // RFC 1929 caps each field at 255 bytes.
+            if (utf8Length(user) > 255 || utf8Length(password) > 255) {
+                throw new IllegalArgumentException("proxy credentials are too long");
+            }
+        }
+
+        String host;
+        String port;
+        if (s.startsWith("[")) {
+            int close = s.indexOf(']');
+            if (close < 0 || close + 1 >= s.length() || s.charAt(close + 1) != ':') {
+                throw new IllegalArgumentException("invalid bracketed proxy host");
+            }
+            host = s.substring(1, close);
+            port = s.substring(close + 2);
+            if (host.isEmpty() || !host.matches("[0-9A-Fa-f:.%a-zA-Z]+") || host.indexOf(':') < 0) {
+                throw new IllegalArgumentException("invalid IPv6 proxy host");
+            }
+        } else {
+            int colon = s.lastIndexOf(':');
+            if (colon <= 0) throw new IllegalArgumentException("proxy needs host:port");
+            host = s.substring(0, colon);
+            port = s.substring(colon + 1);
+            if (host.indexOf(':') >= 0) {
+                throw new IllegalArgumentException("wrap IPv6 proxy hosts in brackets");
+            }
+            if (!host.matches("[A-Za-z0-9._-]+")) {
+                throw new IllegalArgumentException("invalid proxy host");
+            }
+        }
+
+        if (!port.matches("[0-9]{1,5}")) throw new IllegalArgumentException("invalid proxy port");
+        int number = Integer.parseInt(port);
+        if (number < 1 || number > 65535) throw new IllegalArgumentException("proxy port out of range");
+        return new Endpoint(host, number, user, password);
+    }
+
+    private static int utf8Length(String value) {
+        return value.getBytes(java.nio.charset.StandardCharsets.UTF_8).length;
+    }
+
+    /**
+     * The JDK's SOCKS client asks {@link Authenticator} for username/password
+     * (RFC 1929). Answer only SOCKS requests for the configured endpoint, so no
+     * other HTTP challenge ever receives these credentials. Installed lazily, and
+     * only once a setting actually carries credentials.
+     */
+    private static synchronized void installAuthenticator() {
+        if (authenticatorInstalled) return;
+        Authenticator.setDefault(new Authenticator() {
+            @Override
+            protected PasswordAuthentication getPasswordAuthentication() {
+                Endpoint e = endpoint;
+                if (e == null || e.user == null) return null;
+                String protocol = getRequestingProtocol();
+                if (protocol == null || !protocol.toUpperCase(Locale.ROOT).startsWith("SOCKS")) {
+                    return null;
+                }
+                String host = getRequestingHost();
+                if (getRequestingPort() != e.port || host == null || !host.equalsIgnoreCase(e.host)) {
+                    return null;
+                }
+                return new PasswordAuthentication(e.user, e.password.toCharArray());
+            }
+        });
+        authenticatorInstalled = true;
+    }
+}
diff --git a/player-core/src/main/java/dev/t1m3/qplayer/util/UpdateDownloader.java b/player-core/src/main/java/dev/t1m3/qplayer/util/UpdateDownloader.java
new file mode 100644
index 0000000000000000000000000000000000000000..06d9de1cc7b881c0f0994ba43a86dfae8e22c3da
--- /dev/null
+++ b/player-core/src/main/java/dev/t1m3/qplayer/util/UpdateDownloader.java
@@ -0,0 +1,75 @@
+package dev.t1m3.qplayer.util;
+
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+import okhttp3.ResponseBody;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.util.concurrent.TimeUnit;
+import java.util.function.IntConsumer;
+
+/**
+ * Downloads one application update candidate for the Android and desktop hosts.
+ * OkHttp routes GitHub hosts through {@link NetworkProxy}, handing the SOCKS5
+ * proxy the host name so DNS is resolved remotely rather than by a possibly
+ * polluted local resolver.
+ */
+public final class UpdateDownloader {
+    private static final class Client {
+        static final OkHttpClient INSTANCE = new OkHttpClient.Builder()
+                .connectTimeout(15, TimeUnit.SECONDS)
+                .readTimeout(30, TimeUnit.SECONDS)
+                .writeTimeout(0, TimeUnit.MILLISECONDS)
+                .proxySelector(NetworkProxy.selector())
+                .build();
+    }
+
+    private UpdateDownloader() {}
+
+    /**
+     * Download {@code url} into {@code out}, reporting 0..100 to {@code progress}
+     * when the length is known. Returns false on any failure so the caller can try
+     * the next mirror.
+     */
+    public static boolean downloadOne(String url, File out, IntConsumer progress) {
+        return downloadOne(Client.INSTANCE, url, out, progress);
+    }
+
+    static boolean downloadOne(OkHttpClient client, String url, File out, IntConsumer progress) {
+        Request request = new Request.Builder()
+                .url(url)
+                .header("User-Agent", "qplayer-updater")
+                // Raw bytes keep Content-Length meaningful for the progress bar.
+                .header("Accept-Encoding", "identity")
+                .build();
+        try (Response response = client.newCall(request).execute()) {
+            if (response.code() >= 400) return false;
+            ResponseBody body = response.body();
+            long total = body.contentLength();
+            try (InputStream in = body.byteStream(); FileOutputStream fos = new FileOutputStream(out)) {
+                byte[] buf = new byte[16384];
+                long read = 0;
+                int n;
+                int lastPct = -1;
+                while ((n = in.read(buf)) > 0) {
+                    fos.write(buf, 0, n);
+                    read += n;
+                    if (total > 0) {
+                        int pct = (int) (read * 100 / total);
+                        if (pct != lastPct) {
+                            lastPct = pct;
+                            progress.accept(pct);
+                        }
+                    }
+                }
+            }
+            return out.length() > 0;
+        } catch (Throwable e) {
+            Logger.warn("update download failed {}: {}", url, e.toString());
+            return false;
+        }
+    }
+}
